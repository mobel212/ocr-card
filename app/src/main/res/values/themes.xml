<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.Ocrv3" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">#f6f7fd</item>
    </style>

    <!-- The Splash Screen Theme -->
    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <!-- Set the background color to BackgroundLight -->
        <item name="windowSplashScreenBackground">#f6f7fd</item>

        <!-- Point to your new XML vector icon -->
        <item name="windowSplashScreenAnimatedIcon">@drawable/app_icon</item>

        <!-- Tell it to transition to your main theme when it's done loading -->
        <item name="postSplashScreenTheme">@style/Theme.Ocrv3</item>
    </style>

</resources>